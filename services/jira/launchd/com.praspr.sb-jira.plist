<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.praspr.sb-jira</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/praspr/.local/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/praspr/Documents/code_home/sb/services/jira</string>

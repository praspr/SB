<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.praspr.sb</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/praspr/.local/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/praspr/Documents/code_home/sb/services/core</string>
